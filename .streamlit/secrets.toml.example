# Copie ce fichier en .streamlit/secrets.toml et renseigne tes identifiants.
# ⚠️ Ne committe JAMAIS secrets.toml (il est ignoré par .gitignore).

EMAIL_SENDER = "ton.adresse@yahoo.fr"
EMAIL_PASSWORD = "mot_de_passe_application"   # Yahoo/Gmail : mot de passe d'application (2FA requise)
EMAIL_RECEIVER = "destinataire@exemple.com"

# Optionnel : forcer le serveur SMTP (sinon déduit du domaine de l'expéditeur).
# SMTP_HOST = "smtp.mail.yahoo.com"   # Yahoo ; Gmail : smtp.gmail.com
# SMTP_PORT = 587
